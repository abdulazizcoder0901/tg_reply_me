# https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# @BotFather'dan olingan token
BOT_TOKEN=123456789:AAAA...

# Xabarnoma qaysi Telegram ID ga yuborilsin (bo'sh = o'zingizning akkauntingiz)
OWNER_ID=

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Kuzatilmasin degan chatlar ID lari, vergul bilan (masalan: -1001234567890,-1009876543210)
IGNORE_CHATS=
